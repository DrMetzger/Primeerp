# API do Prime Hub (TypeScript 7 -> um arquivo só com esbuild).
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN COREPACK_ENABLE_DOWNLOAD_PROMPT=0 pnpm install --frozen-lockfile --filter @primehub/api...
RUN cd apps/api && pnpm exec tsc --noEmit -p . && pnpm build

FROM node:22-alpine
ENV NODE_ENV=production TZ=America/Sao_Paulo
RUN apk add --no-cache tzdata
WORKDIR /app
COPY --from=build /app/apps/api/dist/index.mjs ./index.mjs
USER node
EXPOSE 3000
CMD ["node", "index.mjs"]
