{
  "name": "@primehub/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hono/node-server": "2.1.7",
    "@primehub/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "hono": "4.13.18",
    "jose": "6.2.17",
    "mysql2": "3.24.6",
    "zod": "4.6.7",
    "nodemailer": "10.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "@types/nodemailer": "8.0.2"
  }
}